<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false" scan="true" scanPeriod="60 seconds" >

    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <include resource="property.xml" />

    <contextListener class="top.jpower.core.log.listener.LoggerStartupListener"/>

    <!-- 彩色日志 -->
    <!-- 彩色日志依赖的渲染类 -->
    <conversionRule conversionWord="clr" converterClass="top.jpower.core.log.color.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />
    <!-- 彩色日志格式 -->
    <property name="CONSOLE_LOG_PATTERN" value="${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){blue} %clr(%5level) %clr(${spring.application.name:- }:${jpower.version:- }){bright_yellow} %clr(%traceId){red} %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%logger){cyan}%clr(\(){bright_cyan}%clr(%clr(%line){bright_cyan}){bold}%clr(\)){bright_cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <!--控制台日志， 控制台输出 -->
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="top.jpower.core.log.trace.TraceIdLayout">
                <!--格式化输出：%d表示日期，%thread表示线程名，%-5level：级别从左显示5个字符宽度%msg：日志消息，%n是换行符-->
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </layout>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--  日志文件输出  -->
    <if condition='property("mode").contains("file")'>
        <then>
            <include resource="logback-file.xml" />
        </then>
    </if>

    <!--  skywalking日志输出  -->
    <if condition='property("mode").contains("skywalking")'>
        <then>
            <include resource="logback-skywalking.xml" />
        </then>
    </if>

    <!--  ELK日志输出  -->
    <if condition='property("mode").contains("elk")'>
        <then>
            <include resource="logback-elk.xml" />
        </then>
    </if>

    <logger name="org.apache" level="info"/>
    <logger name="org.hibernate" level="info"/>
    <logger name="com.baomidou.mybatisplus" level="info"/>
    <logger name="org.mybatis.spring" level="info"/>
    <logger name="org.springframework.beans" level="info"/>
    <logger name="org.springframework.boot" level="info"/>
    <logger name="org.springframework.context" level="info"/>
    <logger name="org.springframework.data" level="info"/>
    <logger name="org.springframework.core.env" level="info"/>
    <logger name="org.springframework.web" level="info"/>
    <logger name="druid.sql" level="info"/>
    <logger name="com.springboot" level="info"/>
    <logger name="com.alibaba" level="info"/>
    <logger name="springfox.documentation" level="info" />
    <logger name="_org.springframework.web.servlet.HandlerMapping.Mappings" level="info" />
    <logger name="_org.springframework.web.reactive.HandlerMapping.Mappings" level="info" />

    <!-- 日志输出级别 -->
    <if condition='property("mode").contains("file")'>
        <then>
            <root level="${level}">
                <appender-ref ref="log_file"/>
                <appender-ref ref="error_file"/>
            </root>
        </then>
    </if>
    <if condition='property("mode").contains("skywalking")'>
        <then>
            <root level="${level}">
                <appender-ref ref="log_skywalking"/>
            </root>
        </then>
    </if>
    <if condition='property("mode").contains("elk")'>
        <then>
            <root level="${level}">
                <appender-ref ref="log_logstash"/>
            </root>
        </then>
    </if>

    <springProfile name="dev">
        <root level="${level}">
            <appender-ref ref="stdout" />
        </root>
    </springProfile>
</configuration>
